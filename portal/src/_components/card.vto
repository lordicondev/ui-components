{{# One demo on the index. Its video plays while the pointer or focus is on the card, from
    main.ts; until then the card shows the video's first frame. A demo without a video shows
    its icon, which waits for the pointer, a click or focus on the card. #}}
<li class="card">
    <a class="card__link" href="{{ demo.links.page |> url }}">
        <span class="card__media">
            {{ if demo.thumbnail }}
                <img
                    class="card__poster"
                    alt=""
                    src="{{ demo.thumbnail.poster |> url }}"
                    width="400"
                    height="300"
                    loading="lazy"
                />
                <video
                    class="card__video"
                    src="{{ demo.thumbnail.video |> url }}"
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-hidden="true"
                    data-preview
                ></video>
            {{ else }}
                <lord-icon
                    current-color
                    src="{{ `${demo.links.app}icons/${demo.cover}.json` |> url }}"
                    loading="interaction"
                    trigger="hover"
                    target=".card__link"
                    aria-hidden="true"
                >
                    <img alt="" src="{{ `${demo.links.app}icons/${demo.cover}.svg` |> url }}" />
                </lord-icon>
            {{ /if }}
        </span>

        <span class="card__body">
            <h3 class="card__title">{{ demo.title }}</h3>
            <p class="card__description">{{ demo.description }}</p>
        </span>
    </a>
</li>
