{{# The demo list, by group. From 900px it is a column beside the page. Below that it is a bar with
    a menu button, and the list is a popover that unrolls from under the bar: the browser
    opens it, closes it on Escape or a tap elsewhere, and keeps it in the tab order after
    the button. #}}
<nav class="sidebar" aria-label="Demos">
    <div class="sidebar__bar">
        <a class="sidebar__home" href="{{ '/' |> url }}" aria-label="{{ demos.site.title }}">
            <lord-icon
                src="{{ '/images/logo.json' |> url }}"
                loading="interaction"
                trigger="hover"
                target=".sidebar__home"
                aria-hidden="true"
                current-color
            >
                <img alt="" src="{{ '/images/logo.svg' |> url }}" />
            </lord-icon>
        </a>

        {{# Two icons in one button: the burger at rest, and a cross that draws itself in
            when the menu opens. aria-expanded is written by main.ts. #}}
        <button
            class="sidebar__toggle"
            type="button"
            popovertarget="site-menu"
            aria-expanded="false"
            aria-label="Menu"
        >
            <lord-icon
                class="sidebar__burger"
                current-color
                src="{{ '/icons/system-regular-379-menu-hamburger.json' |> url }}"
                loading="interaction"
                trigger="hover"
                target=".sidebar__toggle"
                aria-hidden="true"
            >
                <img alt="" src="{{ '/icons/system-regular-379-menu-hamburger.svg' |> url }}" />
            </lord-icon>
            <lord-icon
                class="sidebar__cross"
                current-color
                src="{{ '/icons/system-outline-38-cross.json' |> url }}"
                loading="interaction"
                trigger="follow(aria-expanded)"
                target=".sidebar__toggle"
                state="in-reveal"
                aria-hidden="true"
            ></lord-icon>
        </button>
    </div>

    <div class="sidebar__panel" id="site-menu" popover>
        {{# One row per group, a tree the browser opens and closes: the group of the page you
            are on starts open. #}}
        <ul class="sidebar__list">
            {{ for index, group of demos.groups }}
                {{ set members = demos.demos.filter((demo) => demo.group === group.id) }}
                {{# --order staggers the rows as the menu opens. #}}
                <li style="--order: {{ index }}">
                    <details
                        class="sidebar__group"
                        {{ if members.some((demo) => demo.links.page === url) }}open{{ /if }}
                    >
                        <summary class="sidebar__summary">
                            <lord-icon
                                class="sidebar__chevron"
                                current-color
                                src="{{ '/icons/system-outline-31-chevron-right.json' |> url }}"
                                loading="interaction"
                                trigger="hover"
                                target=".sidebar__summary"
                                aria-hidden="true"
                            >
                                <img alt="" src="{{ '/icons/system-outline-31-chevron-right.svg' |> url }}" />
                            </lord-icon>
                            {{ group.title }}
                        </summary>

                        <ul class="sidebar__links">
                            {{ for demo of members }}
                                <li>
                                    <a
                                        class="sidebar__link"
                                        href="{{ demo.links.page |> url }}"
                                        {{ if url === demo.links.page }}aria-current="page"{{ /if }}
                                    >
                                        {{ demo.title }}
                                    </a>
                                </li>
                            {{ /for }}
                        </ul>
                    </details>
                </li>
            {{ /for }}
        </ul>

        <p class="sidebar__version">v{{ demos.site.version }}</p>
    </div>
</nav>
