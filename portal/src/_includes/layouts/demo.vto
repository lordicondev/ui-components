---
layout: layouts/base.vto
---

<article class="demo-page demo-page--{{ demo.stage }}">
    {{# The stage's height comes from CSS, by the size the demo picks, so nothing below it
        moves when the demo loads. #}}
    <div class="demo-page__intro">
        <header class="demo-page__head">
        <div class="demo-page__title">
            <h1>{{ demo.title }}</h1>

            {{# Actions on the demo, on the title's line. #}}
            <div class="actions">
                <a
                    class="action"
                    href="{{ demo.links.app |> url }}"
                    target="_blank"
                    rel="noopener"
                    title="Open the demo full screen"
                    aria-label="Open the demo full screen"
                >
                    <lord-icon
                        current-color
                        src="{{ '/icons/system-outline-751-arrow-out-square.json' |> url }}"
                        loading="interaction"
                        trigger="hover"
                        target=".action"
                        aria-hidden="true"
                    >
                        <img alt="" src="{{ '/icons/system-outline-751-arrow-out-square.svg' |> url }}" />
                    </lord-icon>
                </a>
            </div>
        </div>

            <p class="demo-page__lead">{{ demo.description }}</p>
        </header>

    {{# The demo in an iframe, which keeps its styles out of the portal. The frame's height
        comes from the demo, so it never scrolls. #}}
        <section class="stage">
            <div class="stage__frame" data-frame>
                <iframe
                    src="{{ demo.links.app |> url }}"
                    title="{{ demo.title }} demo"
                    data-stage
                ></iframe>
            </div>
        </section>
    </div>

    <section class="take-it">
        <h2>Get the code</h2>
        <p>
            This demo also exists as a standalone project —
            <code>npm install &amp;&amp; npm run dev</code>, no changes needed.
        </p>

        <div class="terminal">
            <pre class="terminal__body"><code>{{ demo.links.terminal }}</code></pre>
            <button type="button" class="copy" data-copy>Copy</button>
        </div>

        {{# What the command does, since the slug appears in it twice. #}}
        <p class="take-it__note">
            Copies the <code>{{ demo.slug }}</code> folder of the
            <code>{{ demos.site.standaloneBranch }}</code> branch — where every demo lives
            on its own — into <code>./{{ demo.slug }}</code>.
        </p>

        {{# Run it, download it, read it. #}}
        <ul class="buttons">
            <li>
                <a
                    class="button"
                    href="{{ demo.links.stackblitz }}"
                    target="_blank"
                    rel="noopener"
                >Open in StackBlitz</a>
            </li>
            {{ if demo.codepen }}
                <li>
                    <a class="button" href="{{ demo.codepen }}" target="_blank" rel="noopener">
                        Open in CodePen
                    </a>
                </li>
            {{ /if }}
            <li><a class="button" href="{{ demo.links.zip |> url }}">Download ZIP</a></li>
            <li>
                <a class="button" href="{{ demo.links.github }}" target="_blank" rel="noopener">
                    Code on GitHub
                </a>
            </li>
        </ul>
    </section>

    <section class="reading">
        <h2>How it works</h2>
        <p class="reading__legend">
            Define the element, put the icon in the markup, set the control's state. Then
            the parts that make this demo different.
        </p>
        {{ for fragment of demo.fragments }}
            {{ comp.code({
                title: fragment.title,
                note: fragment.note,
                lang: fragment.lang,
                collapsed: fragment.collapsed,
                variants: "ts" in fragment,
                ts: fragment.ts,
                js: fragment.js,
                code: fragment.code,
                tsFull: fragment.tsFull,
                jsFull: fragment.jsFull,
                full: fragment.full,
            }) }}
        {{ /for }}
    </section>

    <section class="reading">
        <h2>Source files</h2>
        <p class="reading__legend">
            The demo's own files, whole, at the paths the export uses.
        </p>
        {{ for file of demo.own }}
            {{ comp.code({
                title: file.path,
                note: `${file.lines} lines`,
                lang: file.lang,
                collapsed: true,
                variants: "ts" in file,
                ts: file.ts,
                js: file.js,
                code: file.code,
            }) }}
        {{ /for }}

        {{# The shared files the demo imports, folded: they are the same under every demo. #}}
        <details class="imports">
            <summary class="imports__link">
                What it imports
                <span class="imports__count">{{ demo.imported.length }} shared files</span>
            </summary>

            <div class="imports__files">
                {{ for file of demo.imported }}
                    {{ comp.code({
                        title: file.path,
                        note: `${file.lines} lines`,
                        lang: file.lang,
                        collapsed: true,
                        variants: "ts" in file,
                        ts: file.ts,
                        js: file.js,
                        code: file.code,
                    }) }}
                {{ /for }}
            </div>
        </details>
    </section>

    <section class="icons-used">
        <h2>Icons</h2>
        <p class="reading__legend">
            Hover a row to play its icon. A state marked default plays without a
            <code>state</code> attribute. The icons are under the
            <a href="{{ demos.site.lordicon.licenses }}" target="_blank" rel="noopener">Lordicon License
                Terms</a>, not the MIT licence of the code.
        </p>

        {{# What to know before swapping an icon, written for the demo. #}}
        {{ if demo.iconsNote }}
            <aside class="icons-note">
                <lord-icon
                    class="icons-note__icon"
                    current-color
                    src="{{ '/icons/system-outline-367-info-circle.json' |> url }}"
                    loading="interaction"
                    trigger="hover"
                    target=".icons-note"
                    aria-hidden="true"
                >
                    <img alt="" src="{{ '/icons/system-outline-367-info-circle.svg' |> url }}" />
                </lord-icon>
                <p>
                    The <strong>Animation state</strong> column shows which icon state to use
                    to get the effect from the example. {{ demo.iconsNote }}
                </p>
            </aside>
        {{ /if }}

        <table class="icon-table">
            <thead>
                <tr>
                    <th scope="col"><span class="visually-hidden">Preview</span></th>
                    <th scope="col">Lordicon icon</th>
                    <th scope="col">Animation state</th>
                </tr>
            </thead>
            <tbody>
                {{ for icon of demo.icons }}
                    <tr>
                        <td class="icon-table__preview">
                            <span class="icon-table__well">
                                <lord-icon
                                    current-color
                                    src="{{ `${demo.links.app}icons/${icon.alias}.json` |> url }}"
                                    {{ if icon.preview.state }}state="{{ icon.preview.state }}"{{ /if }}
                                    loading="interaction"
                                    trigger="{{ icon.preview.trigger }}"
                                    target=".icon-table tr"
                                    aria-hidden="true"
                                >
                                    <img
                                        alt=""
                                        src="{{ `${demo.links.app}icons/${icon.alias}.svg` |> url }}"
                                    />
                                </lord-icon>
                            </span>
                        </td>
                        <td class="icon-table__id">
                            {{ if icon.url }}
                                <a href="{{ icon.url }}" target="_blank" rel="noopener">{{ icon.id }}</a>
                            {{ else }}
                                {{ icon.id }}
                            {{ /if }}
                        </td>
                        <td>
                            {{# A default state is the one the icon plays without a state
                                attribute, so the markup does not name it. #}}
                            <div class="icon-table__states">
                                {{ for state of icon.states }}
                                    {{ if state.default }}
                                        <span
                                            class="state state--default"
                                            title="Plays without a state attribute"
                                        ><code>{{ state.name }}</code> <span class="state__default">default</span></span>
                                    {{ else }}
                                        <span class="state"><code>{{ state.name }}</code></span>
                                    {{ /if }}
                                {{ /for }}
                            </div>
                        </td>
                    </tr>
                {{ /for }}
            </tbody>
        </table>
    </section>
</article>
