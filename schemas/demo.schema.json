{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Demo manifest",
    "description": "Everything the portal needs to build a demo page. The portal reads nothing else.",
    "type": "object",
    "additionalProperties": false,
    "required": ["slug", "title", "description", "group", "icons", "fragments"],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "description": "Folder name. The only identity a demo has \u2014 never change it after publishing."
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string",
            "minLength": 1
        },
        "group": {
            "enum": ["buttons", "inputs", "menus", "navigation", "feedback", "cards", "text"],
            "description": "The section of the portal's index the demo is listed in. Titles and order are in scripts/prepare-portal.ts."
        },
        "stage": {
            "enum": ["small", "medium", "large"],
            "description": "How tall the demo's frame is in the portal: small 360px, medium 520px, large the rest of the first screen. Pick the smallest that fits the demo with its menus open. Large when left out."
        },
        "icons": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Icon aliases from shared/icons.json. The export ships these, plus the pager's arrows."
        },
        "fragments": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "file", "region", "lang", "title"],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "file": {
                        "type": "string"
                    },
                    "region": {
                        "type": "string"
                    },
                    "lang": {
                        "enum": ["html", "ts", "css"]
                    },
                    "title": {
                        "type": "string"
                    },
                    "note": {
                        "type": "string",
                        "description": "One line of context, shown under the title in the portal."
                    }
                }
            }
        }
    }
}
